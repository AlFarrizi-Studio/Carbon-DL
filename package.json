{
  "name": "carbon-dl",
  "version": "1.0.0",
  "description": "Carbon — grab any video or music from anywhere. pick format, fps, quality. download. done.",
  "type": "module",
  "bin": {
    "carbon": "dist/cli.js",
    "carbon-dl": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js",
    "carbon": "node dist/cli.js"
  },
  "author": "Carbon",
  "keywords": [
    "video",
    "audio",
    "music",
    "downloader",
    "yt-dlp",
    "youtube",
    "instagram",
    "twitter",
    "tiktok",
    "cli",
    "tui",
    "ink",
    "mp4",
    "mp3",
    "fps"
  ],
  "license": "MIT",
  "dependencies": {
    "ink": "^7.1.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.7",
    "sharp": "^0.35.3",
    "sixel": "^0.16.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
